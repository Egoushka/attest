<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Description>DataAnnotations attributes for Attest: validate a national identification number, tax identification number or VAT code on a model property.</Description>
    <PackageId>Attest.DataAnnotations</PackageId>
  </PropertyGroup>



  <ItemGroup>
    <!-- ValidationAttribute and ValidationContext are in-box from net8.0 onwards, so the package is
         only needed for the netstandard2.0 leg. Declaring it for both put a redundant dependency in
         every net8.0 consumer's graph. -->
    <PackageReference Include="System.ComponentModel.Annotations" Version="4.7.0"
                      Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\Attest\Attest.csproj" />
  </ItemGroup>


</Project>
