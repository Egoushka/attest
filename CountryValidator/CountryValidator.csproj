<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Validates VAT codes, social security numbers and tax identification numbers for individuals and companies in 80+ countries. Maintained fork of CountryValidator by Anghel Valentin, drop-in compatible with it.</Description>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Authors>Anghel Valentin, Yehor Hrabovskyi</Authors>
    <RepositoryType>git</RepositoryType>
    <PackageTags>VAT, SSN, Id, Social Security Number, TIN, Countries Validator, Validator</PackageTags>
    <PackageIcon>CountryValidator.png</PackageIcon>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Egoushka/country-validator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Egoushka/country-validator</RepositoryUrl>
    <RootNamespace>CountryValidation</RootNamespace>
    <AssemblyName>CountryValidator</AssemblyName>
    <PackageId>CountryValidator.Community</PackageId>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Version>1.2.0</Version>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\CountryValidator.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
