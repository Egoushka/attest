<?xml version="1.0" encoding="utf-8"?>
<!--
  Scoped to this folder, so it cannot affect a restore of Attest.sln. The local feed is where
  ci.yml's pack step writes, and it has to be listed before nuget.org: the same version exists on
  nuget.org for a released tag, and the point of this project is to compile against what was just
  built rather than what was published.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
