<Project>

  <!--
    Shared package metadata. The version here is a placeholder for local builds only: the
    release workflow passes -p:Version from the git tag, so the tag is the single source of
    truth and the two projects cannot drift apart. See RELEASING.md.
  -->
  <PropertyGroup>
    <Version>1.0.0-dev</Version>
    <Authors>Anghel Valentin, Yehor Hrabovskyi</Authors>
    <Copyright>Copyright 2020 Anghel Valentin, 2026 Yehor Hrabovskyi</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Egoushka/attest</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Egoushka/attest</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Space separated: NuGet treats a comma-joined list as a single tag, so "tax identification
         number" was one token nobody searches for.

         The second line is the local name of the number, which is what a developer in that country
         actually searches for: a Brazilian looks for "CPF", not "national id". Every one of these is
         a number this library validates - see the country table in README.md. -->
    <PackageTags>vat ssn tin tax-id national-id personal-id company-number postal-code zipcode validation checksum country iso3166 dataannotations countryvalidator cpf cnpj pesel nip bsn btw nif cif nie codice-fiscale partita-iva steuernummer rfc curp pan gstin aadhaar personnummer hetu abn</PackageTags>
    <PackageReleaseNotes>See CHANGELOG.md at https://github.com/Egoushka/attest/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <!--
    Debugging into the package from a consumer's IDE. SourceLink ships in the .NET 8 SDK, so
    these are properties rather than a PackageReference.
  -->
  <!--
    The condition below cannot read IsPackable: this file is imported before the project body sets
    it, so it is empty here and the group always applies. A project that ships nothing turns
    GenerateDocumentationFile off itself.
  -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591 was suppressed here while 417 public members had no XML doc. They all have one now, so
      the warning is live again and the build says so the next time a public member ships without
      one. ci.yml builds with -warnaserror, which makes that a failure rather than a note.
    -->
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
